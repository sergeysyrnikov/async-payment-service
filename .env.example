POSTGRES_PORT=5432
POSTGRES_USER=async_payment_user
POSTGRES_PASSWORD=async_payment_password
POSTGRES_DB=async_payment_db

DATABASE_DSN=postgresql+asyncpg://async_payment_user:async_payment_password@async_payment_service_postgres:5432/async_payment_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=60
DATABASE_POOL_RECYCLE=3600

APP_NAME=Async Payment Service
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

SECURITY_API_KEY=your_api_key_here

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=payments.events
RABBITMQ_PAYMENT_QUEUE=payments.new
RABBITMQ_PAYMENT_ROUTING_KEY=payments.new
RABBITMQ_DEAD_LETTER_EXCHANGE=payments.dlx
RABBITMQ_DEAD_LETTER_QUEUE=payments.dead
RABBITMQ_DEAD_LETTER_ROUTING_KEY=payments.dead
RABBITMQ_MAX_ATTEMPTS=3
RABBITMQ_RETRY_BASE_DELAY_SEC=1.0
RABBITMQ_OUTBOX_POLL_INTERVAL_SEC=1.0
RABBITMQ_OUTBOX_BATCH_SIZE=50

PAYMENT_PROCESSING_MIN_DELAY_SEC=2.0
PAYMENT_PROCESSING_MAX_DELAY_SEC=5.0
PAYMENT_PROCESSING_SUCCESS_PROBABILITY=0.9
PAYMENT_PROCESSING_WEBHOOK_TIMEOUT_SEC=10.0
PAYMENT_PROCESSING_WEBHOOK_MAX_ATTEMPTS=3
PAYMENT_PROCESSING_WEBHOOK_RETRY_BASE_DELAY_SEC=1.0

CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
